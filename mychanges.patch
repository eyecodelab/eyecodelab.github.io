+        "blog-11-title": "Tạo nhân vật ảo biết nói bằng AI từ ảnh 2D & giọng nói",
+        "blog-11-author": "Hồ Quốc Nhân Hoà, ĐH KHTN TP.HCM"
+      }
+    };
+function setLanguage(lang) {
+    localStorage.setItem('language', lang);
+
+    const currentUrl = new URL(window.location.href);
+    currentUrl.searchParams.set('lang', lang);
+    window.location.href = currentUrl.href;
+}
+
+function changeLanguage(lang) {
+    document.querySelectorAll('[data-i18n]').forEach(el => {
+        const key = el.getAttribute('data-i18n');
+        if (translations[lang] && translations[lang][key]) {
+            el.innerText = translations[lang][key];
+        }
+    });
+    const langDisplay = document.getElementById('lang-current');
+    if (langDisplay) langDisplay.innerText = lang.toUpperCase();
+   
+}
+
+document.addEventListener("DOMContentLoaded", function () {
+    const urlParams = new URLSearchParams(window.location.search);
+    const urlLang = urlParams.get('lang');
+
+
+    if (urlLang) {
+        localStorage.setItem('language', urlLang);
+    }
+
+    const lang = localStorage.getItem('language') || 'en';
+    changeLanguage(lang);
+
+    const langDisplay = document.getElementById('lang-current');
+    if (langDisplay) langDisplay.innerText = lang.toUpperCase();
+
+    document.querySelectorAll('.dropdown-item').forEach(option => {
+        option.classList.remove('active');
+        if (option.textContent.trim().toLowerCase() === lang.toLowerCase()) {
+            option.classList.add('active');
+        }
+    });
+
+    document.querySelectorAll('a[href]').forEach(link => {
+        const href = link.getAttribute('href');
+
+        if (
+            href.startsWith('#') ||
+            href.startsWith('http') ||
+            href.startsWith('mailto') ||
+            href.includes('lang=')
+        ) return;
+
+        const url = new URL(href, window.location.origin);
+        url.searchParams.set('lang', lang);
+        link.setAttribute('href', url.toString());
+    });
+});
+document.getElementById("subscribe-form").addEventListener("submit", function (e) {
+    e.preventDefault();
+
+    const form = e.target;
+    const formData = new FormData(form);
+    const messageDiv = document.getElementById("form-success-message1");
+
+    fetch(form.action, {
+      method: "POST",
+      mode: "no-cors",
+      body: formData,
+    }).then(() => {
+      form.style.display = "none"; 
+      messageDiv.style.display = "block"; 
+    }).catch(() => {
+      form.style.display = "none";
+      messageDiv.style.display = "block";
+      messageDiv.style.color = "red";
+      messageDiv.textContent = "Đã xảy lỗi. Vui lòng thử lại sau.";
+    });
+  });
